# Copy to deploy/aether.env (never committed) and fill in.

# The server's public IPv4 address: what browsers reach media and the relay on.
# Required in a container (its own address is a private bridge address).
AETHER_PUBLIC_IP=203.0.113.10

# Your hostname(s), comma-separated; a certificate is obtained and renewed
# automatically from Let's Encrypt. Point the DNS A record here first.
AETHER_ACME_DOMAIN=meet.example.com
AETHER_ACME_EMAIL=admin@example.com

# The first administrator, created on the first start of an empty database.
# Leave the password empty to have one generated and printed once in the logs.
AETHER_ADMIN_EMAIL=admin@example.com
AETHER_ADMIN_PASSWORD=

# Open sign-up (anyone can create an account, like a public meeting service).
# false: only an administrator creates accounts.
AETHER_ALLOW_SIGNUP=true

# Outgoing email (password reset links). Any SMTP server: your organisation's,
# your own, or a provider's. Port 465 is TLS from the start; any other port must
# offer STARTTLS -- mail is never sent unencrypted. Leave AETHER_SMTP_ADDR empty
# and password reset is not offered (an administrator can still set a new one).
# Links point at AETHER_PUBLIC_URL, or https:// and the first ACME domain.
# AETHER_SMTP_ADDR=smtp.example.com:587
# AETHER_SMTP_USER=aether@example.com
# AETHER_SMTP_PASSWORD=
# AETHER_SMTP_FROM=noreply@example.com
# AETHER_PUBLIC_URL=https://meet.example.com

# Behind your own reverse proxy instead of on 443 directly? Set this only if
# that proxy is yours and strips any X-Forwarded-For a client sent.
# AETHER_TRUST_PROXY=false
